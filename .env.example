# Copy to .env and fill in real values. Never commit the real .env file.

# MongoDB connection string
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/asc

# Secret used to sign/verify access token JWTs — any long random string
JWT_SECRET=

# Cloudinary (image uploads — config/cloudinary.js)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
# Signing secret for the course-subscription webhook endpoint (Stripe Dashboard → Webhooks → /courses/webhook)
STRIPE_COURSE_WEBHOOK_SECRET=
# Signing secret for the event-subscription webhook endpoint (Stripe Dashboard → Webhooks → /events/subscriptions/webhook)
STRIPE_EVENT_SUBSCRIPTION_WEBHOOK_SECRET=

# Google OAuth client ID (ID-token verification only — no client secret needed)
GOOGLE_CLIENT_ID=

# Gmail SMTP (config/emailConfig.js) — GMAIL_APP_PASSWORD is a Gmail App Password, not the account password
EMAIL_USER=
GMAIL_APP_PASSWORD=

# Public-facing URLs — no trailing slash
FRONT_END_URL=http://localhost:5173
BACK_END_URL=http://localhost:5000/

# Optional — pino log level (default: error)
LOGGER_LEVEL=

# Optional — local server port (default: 5000). Not used on Vercel.
PORT=5000

# Standard Node env flag — affects CORS localhost allowance, cookie secure/sameSite, and error detail exposure
NODE_ENV=development
